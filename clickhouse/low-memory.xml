<!-- Small-host profile: cap memory and skip ClickHouse's own system log tables, which otherwise grow unbounded. -->
<clickhouse>
  <max_server_memory_usage_to_ram_ratio>0.9</max_server_memory_usage_to_ram_ratio>
  <mark_cache_size>134217728</mark_cache_size>
  <uncompressed_cache_size>0</uncompressed_cache_size>
  <max_concurrent_queries>20</max_concurrent_queries>
  <background_schedule_pool_size>2</background_schedule_pool_size>
  <logger><level>warning</level><console>1</console></logger>
  <query_thread_log remove="1"/>
  <query_log remove="1"/>
  <query_views_log remove="1"/>
  <part_log remove="1"/>
  <trace_log remove="1"/>
  <metric_log remove="1"/>
  <asynchronous_metric_log remove="1"/>
  <processors_profile_log remove="1"/>
  <opentelemetry_span_log remove="1"/>
  <session_log remove="1"/>
  <text_log remove="1"/>
</clickhouse>
