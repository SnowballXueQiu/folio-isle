{
  "name": "folio-isle",
  "version": "0.1.0",
  "private": true,
  "description": "言屿 Folio Isle — project knowledge base with todos, notes and AI analysis",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build && npm run build:worker",
    "build:worker": "esbuild src/worker/main.ts src/scripts/migrate.ts --bundle --platform=node --target=node20 --outdir=dist --format=cjs --packages=bundle --external:pg-native",
    "start": "next start -p 3100",
    "migrate": "tsx src/scripts/migrate.ts",
    "worker": "tsx src/worker/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@tiptap/extension-code-block-lowlight": "^3.35.0",
    "@tiptap/extension-color": "^3.35.0",
    "@tiptap/extension-highlight": "^3.35.0",
    "@tiptap/extension-image": "^3.35.0",
    "@tiptap/extension-placeholder": "^3.35.0",
    "@tiptap/extension-table": "^3.35.0",
    "@tiptap/extension-task-item": "^3.35.0",
    "@tiptap/extension-task-list": "^3.35.0",
    "@tiptap/extension-text-style": "^3.35.0",
    "@tiptap/pm": "^3.35.0",
    "@tiptap/react": "^3.35.0",
    "@tiptap/starter-kit": "^3.35.0",
    "cytoscape": "^3.35.0",
    "github-slugger": "^2.0.0",
    "hast-util-to-string": "^3.0.1",
    "jszip": "^3.10.2",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.79.0",
    "mdast-util-to-string": "^4.0.0",
    "next": "^15.5.29",
    "postgres": "^4.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-highlight": "^7.0.2",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "server-only": "^0.0.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/typography": "^0.5.20",
    "@tiptap/html": "^3.35.0",
    "@types/cytoscape": "^3.31.0",
    "@types/node": "^26.6.7",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
