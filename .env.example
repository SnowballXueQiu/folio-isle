# ---- required ----
POSTGRES_PASSWORD=change-me
# random string >= 16 chars; encrypts secrets stored in site settings (openssl rand -hex 32)
APP_SECRET=change-me-change-me-change-me
# public URL of this site (OAuth callback = $APP_URL/api/auth/callback)
APP_URL=https://doc.infnetwork.net

# ---- bind (the stack listens on loopback; put a reverse proxy / tunnel in front) ----
FOLIO_BIND=127.0.0.1
FOLIO_PORT=3100

# ---- OAuth2 SSO (can also be edited later in 站点设置) ----
SSO_PROVIDER_ID=inf
SSO_PROVIDER_NAME=Inf Network 通行证
SSO_AUTHORIZE_URL=https://sso.infnetwork.net/oauth/authorize
SSO_TOKEN_URL=https://sso.infnetwork.net/oauth/token
SSO_USERINFO_URL=https://sso.infnetwork.net/oauth/userinfo
SSO_CLIENT_ID=folio-isle
SSO_CLIENT_SECRET=
SSO_SCOPE=profile
# optional: usernames that become site admins on login (the first user always does)
SITE_ADMIN_USERNAMES=

# ---- AI provider (OpenAI Chat Completions compatible; can also be edited in 站点设置) ----
AI_PROVIDER_NAME=DeepSeek
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-chat
AI_CONCURRENCY=4

# ---- optional ClickHouse overlay ----
CLICKHOUSE_PASSWORD=change-me
CLICKHOUSE_TTL_DAYS=30

# ---- optional off-host backup target for scripts/backup.sh ----
BACKUP_REMOTE=
